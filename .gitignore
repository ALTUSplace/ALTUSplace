.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
*.bak

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/

# Manus version file (auto-generated, not part of source)
client/public/__manus__/version.json

# Agent scratch logs. These are debug/test-run transcripts, not source: they are
# rewritten on every run and were previously tracked, which buried real changes
# in committed noise.
.manus-logs/
.project-config.json

# Sitemap is generated by scripts/sitemap.mjs, which runs first in `pnpm build`.
# The output is a build artifact, not source: it is rewritten on every build and
# was previously tracked, so it produced spurious diffs on any route-list change.
client/public/sitemap.xml

.vercel
.env*
.aider*

# Git hooks (husky). `.husky/pre-commit` is tracked and shared with the team;
# `.husky/_/` is the generated per-clone shim that `core.hooksPath` points at,
# so it must never be committed.
.husky/_/
