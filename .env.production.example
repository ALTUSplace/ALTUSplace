# ---------------------------------------------------------------------------
# ALTUSplace production environment template
# Copy to .env.production (Railway/VPS) and set each value below.
# Also mirror the VITE_* build-time values into the Vercel project settings
# so the static bundle is compiled with the correct public URLs.
# ---------------------------------------------------------------------------

# --- Server process -----------------------------------------------------------
# Leave empty to bind the default port (3000).
PORT=3000
# 1 runs the demo catalog seed on boot; 0 skips it on production hosts.
DEMO_SEED=1
# Express trusts one reverse-proxy hop (Railway/Vercel already handled by code).
NODE_ENV=production

# --- Supabase / PostgreSQL ----------------------------------------------------
# DATABASE_URL is the single source of truth used by server/db.ts, env.ts and
# drizzle.config.ts. SUPABASE_DB_URL is an optional alias used ONLY when
# DATABASE_URL is empty. Both must point to a PostgreSQL-compatible host.
# The schema, migrations and runtime driver are all PostgreSQL (drizzle-orm/postgres-js).
# For Supabase use the "Transaction pooler" (pgbouncer) or direct session URL:
#   postgresql://postgres.<project>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DB_URL=

# Supabase reserved client keys (only if a future feature uses the browser SDK).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- OAuth & JWT auth ---------------------------------------------------------
# Third-party OAuth portal base URL + this app's id (minting the login flow).
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
# HMAC/JWT secret used to sign session tokens (>= 32 random bytes).
JWT_SECRET=
# OpenId of the platform super-admin account (dashboard bootstrap).
OWNER_OPEN_ID=

# --- Public app metadata (build-time, inline into the static bundle) ----------
VITE_APP_URL=
VITE_APP_LOGO=
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
# WhatsApp support fallback number (international format, e.g. 212600000000).
VITE_WHATSAPP_SUPPORT_PHONE=

# --- Backend ↔ frontend separation (Vercel static + Node API) -----------------
# Leave empty to keep the SPA calling the Node server same-origin via /api/trpc.
# When you split hosts, set this on Vercel to the Node backend tRPC endpoint:
#   VITE_API_URL=https://api.altusplace.com/api/trpc
VITE_API_URL=

# --- Foreign exchange (checkout currency conversion) --------------------------
# Client + server share the SAME rate endpoint contract (10-min TTL cache).
# Leave empty for the built-in static MAD/EUR/USD table on both sides.
VITE_CURRENCY_API_URL=
CURRENCY_API_URL=

# --- Payment gateways ---------------------------------------------------------
# CMI card + bank transfer currently run in SIMULATED mode (no merchant keys
# required). Stripe Connect is fully wired and switches to real mode as soon
# as ALL of the keys below are set AND the vendor has a stripe_account_id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional HMAC secret for the CMI webhook path (/api/v1/payments/webhook).
# The webhook verifies against STRIPE_WEBHOOK_SECRET first, then CMI.
CMI_WEBHOOK_SECRET=

# --- Identity verification (KYC) ----------------------------------------------
# Provider: manual (default) | stripe_identity | persona
VERIFICATION_PROVIDER=manual
VERIFICATION_WEBHOOK_SECRET=
STRIPE_IDENTITY_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=

# --- Notifications (email) ----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Machine translation ------------------------------------------------------
# Provider: aws (default) | google | deepl | none
TRANSLATION_PROVIDER=aws
TRANSLATION_ENABLED=true
AWS_REGION=us-east-1
AWS_TRANSLATE_ACCESS_KEY_ID=
AWS_TRANSLATE_SECRET_ACCESS_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# --- Storage / maps / on-device AI (BUILT_IN_FORGE gateway) -------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Browser-side Mapbox token (client/src/lib/mapbox.ts).
VITE_MAPBOX_TOKEN=
# Browser-side Forge API (Map tiles / frontend media) override.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Redis cache (Upstash) ----------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=true