# Supabase Configuration
# These keys are reserved for the browser-side Supabase client if a future
# feature needs it. The main application database does NOT depend on them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Database Configuration (MySQL-compatible hosts: TiDB, PlanetScale, Aiven, ...)
# DATABASE_URL is the single source of truth used by server/db.ts, env.ts and
# drizzle.config.ts. SUPABASE_DB_URL is an optional alias that is used ONLY when
# DATABASE_URL is empty. Both values must point to a MySQL-compatible host.
# Note: do NOT inject a Postgres (supabase.co) URL here - the schema, migrations
# and runtime driver are all MySQL (drizzle-orm/mysql2).
DATABASE_URL=
SUPABASE_DB_URL=

# Runtime configuration
OAUTH_SERVER_URL=
VITE_APP_URL=
VITE_APP_LOGO=
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# JWT & Auth
JWT_SECRET=
OWNER_OPEN_ID=

# Identity verification (KYC)
# Provider: manual (default) | stripe_identity | persona
VERIFICATION_PROVIDER=manual
VERIFICATION_WEBHOOK_SECRET=
STRIPE_IDENTITY_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=

# Stripe Connect (multi-vendor escrow split payments & payout transfers)
# Leave empty to run in simulated mode (escrow ledger still tracks pending
# payouts, but no real transfers are executed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis Cache Configuration (Upstash Redis)
# Get these from your Upstash dashboard: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_ENABLED=true
